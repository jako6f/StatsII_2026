# Kolmogorov–Smirnov test function (normal reference distribution)
myKS <- function(data) {
# sort data
x <- sort(data)
n <- length(x)
# empirical CDF
ECDF <- ecdf(x)
empiricalCDF <- ECDF(x)
# theoretical CDF under N(0,1)
theoreticalCDF <- pnorm(x)
# KS statistic
D <- max(abs(empiricalCDF - theoreticalCDF))
# Kolmogorov p-value approximation
# p-value = 1 - P(D_n <= D)
#k <- 1:100 # we approximate the infinite sum using the first 1000 terms.
#p_value <- 1 - sum(2 * (-1)^(k-1) * exp(-2 * (k^2) * (D^2) * n)) #(-1)^(k-1) creates the alternating signs; exp(-2 * (k^2) * (D^2) * n) are the exponential terms that shrink rapidly.
k <- 1:100
terms <- 2 * (-1)^(k-1) * exp(-2 * (k^2) * (D^2) * n)
p_value <- sum(terms)
}
return(list(
statistic = D,
p_value = p_value
))
